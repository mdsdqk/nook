#MCP_PUBLIC_URL=https://your-mcp.up.railway.app
#AUTH_UI_PUBLIC_URL=https://your-spiky-host.example
#CONVEX_URL=https://your-deployment.convex.cloud
#PORT=8787
#MCP_MAX_UPLOAD_BYTES=15728640
#MCP_ACCESS_TOKEN_TTL_SEC=3600
#MCP_REFRESH_TOKEN_TTL_SEC=2592000
#MCP_AUTH_CODE_TTL_SEC=600
#MCP_CONSENT_TICKET_TTL_SEC=600
# Required in production (HMAC for consent tickets). Dev falls back to ephemeral secret.
#MCP_CONSENT_SECRET=replace-with-long-random-string
# Optional: require Authorization: Bearer <secret> on POST /register (DCR)
#MCP_DCR_SHARED_SECRET=
#MCP_ALLOW_LOCALHOST_REDIRECTS=true
#MCP_RATE_LIMIT_WINDOW_MS=60000
#MCP_RATE_LIMIT_MAX=60
