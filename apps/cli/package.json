{
  "name": "@nook/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "statement": "./src/index.ts",
    "wealth": "./src/wealth.ts",
    "nook": "./src/nook.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:bundle": "bun run scripts/bundle.ts",
    "publish:npm": "bun run build:bundle && cd dist && npm publish --access public",
    "test": "bun test src"
  },
  "dependencies": {
    "@nook/contracts": "workspace:*",
    "@nook/convex": "workspace:*",
    "@nook/persistence": "workspace:*",
    "@nook/pipeline": "workspace:*",
    "@nook/shared": "workspace:*",
    "commander": "^13.1.0",
    "convex": "^1.43.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.2"
  }
}
