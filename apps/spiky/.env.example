# Deployment URL from `convex dev` / dashboard (ends in .cloud)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Same deployment, HTTP actions URL (ends in .site)
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Local Spiky origin (must match Convex SITE_URL env).
# Loopback equivalents (127.0.0.1 / [::1] on the same port) are trusted automatically.
VITE_SITE_URL=http://localhost:5174

# Hosted MCP server origin (no trailing slash). Required for Assistants UI + OAuth consent approve.
# Local: http://127.0.0.1:8787 — Production: https://your-mcp.up.railway.app
#VITE_MCP_URL=http://127.0.0.1:8787

# Optional Convex env (set via `bunx convex env set`, not here):
# TRUSTED_ORIGINS=http://192.168.1.20:5174

# Google OAuth is enabled automatically when GOOGLE_CLIENT_ID/SECRET
# are set on the Convex deployment (see Spiky login via authPublic.providers).
