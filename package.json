{
  "name": "nook",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@nook/mobile",
    "dev:web": "turbo run dev --filter=@nook/web",
    "dev:spiky": "turbo run dev --filter=@nook/spiky",
    "dev:convex": "turbo run dev --filter=@nook/convex",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "statement": "bun run apps/cli/src/index.ts",
    "wealth": "bun run apps/cli/src/wealth.ts",
    "deploy:convex": "bun run --filter @nook/convex deploy",
    "build:cli": "bun run --filter @nook/cli build:bundle",
    "publish:cli": "bun run --filter @nook/cli publish:npm",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.17",
    "typescript": "5.9.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "convex"
  ]
}
